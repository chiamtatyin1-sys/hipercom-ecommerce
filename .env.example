# Server Environment
PORT=3001
NODE_ENV=development

# Database (SQLite for development)
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET=your_jwt_secret_change_in_production

# Master Admin
MASTER_USERNAME=hipercom
MASTER_PASSWORD=Hipercom123#

# HitPay (Sandbox)
HITPAY_API_URL=https://api.sandbox.hitpay.com
HITPAY_API_KEY=your_hitpay_api_key
HITPAY_SALT=your_hitpay_salt
HITPAY_DEFAULT_LINK=your_default_link

# Frontend URL
CLIENT_URL=http://localhost:5173

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Database Password (for Docker)
DB_PASSWORD=your_database_password