# ============================================
# HiperCom E-Commerce - Production Environment
# Copy this to .env and fill in your values
# ============================================

# Database (PostgreSQL)
DB_USER=hipercom
DB_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_2026
DB_NAME=hipercom

# JWT Secret (Generate a random string)
JWT_SECRET=CHANGE_THIS_RANDOM_SECRET_KEY_2026

# Master Admin Account
MASTER_USERNAME=hipercom
MASTER_PASSWORD=CHANGE_THIS_ADMIN_PASSWORD

# HitPay Payment Gateway
HITPAY_API_URL=https://api.hit-pay.com
HITPAY_API_KEY=your_live_api_key_here
HITPAY_SALT=your_salt_here

# Frontend URL (Your QNAP IP or domain)
CLIENT_URL=http://YOUR_QNAP_IP:5173
VITE_API_URL=http://YOUR_QNAP_IP:3001/api

# Email (HiperCom Company SMTP)
EMAIL_HOST=mail.hipercom.com.my
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=hipercommailserver@hipercom.com.my
EMAIL_PASS=your_email_password_here
EMAIL_FROM=HiperCom <hipercommailserver@hipercom.com.my>

# AI Providers (Optional)
OPENROUTER_API_KEY=your_openrouter_key_here
NVIDIA_API_KEY=your_nvidia_key_here
